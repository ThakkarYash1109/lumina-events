# ==========================================
# Lumina Environment Variables (Template)
# DO NOT store real credentials in this file.
# ==========================================

# Server Configuration
LUMINA_ENV=production
LUMINA_PORT=8080
LUMINA_API_BASE_URL=https://api.luminaevents.in

# Database Configuration (Managed PostgreSQL)
DB_HOST=your-postgres-host.render.com
DB_PORT=5432
DB_NAME=lumina_db
DB_USER=lumina_user
DB_PASSWORD=your_secure_password_here
DB_SSL_MODE=require

# Security & CORS
ALLOWED_ORIGINS=https://luminaevents.in,https://www.luminaevents.in,capacitor://localhost,http://localhost

# Escrow Payment Gateway (Sandbox Test Mode Only)
ESCROW_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_KEY=test_key_sample_lumina_2026
PAYMENT_SANDBOX_SECRET=test_secret_sample_lumina_2026

# Cloud Object Storage (Vendor Portfolios & Backups)
STORAGE_BUCKET_NAME=lumina-vendor-assets
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_cloud_storage_key
STORAGE_SECRET_KEY=your_cloud_storage_secret
